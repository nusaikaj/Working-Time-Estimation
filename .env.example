# Used by docker-compose.yml only. Copy to `.env` in the project root before
# running `docker compose up`.

MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=working_time_estimation
MYSQL_USER=wte_app
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

BACKEND_PORT=5000
FRONTEND_PORT=8080

# Set to true only for the very first `docker compose up` on a fresh
# database — seeds the PM/engineer demo accounts and sample data.
RUN_SEED_ON_BOOT=true
