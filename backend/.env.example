# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=working_time_estimation
DB_USER=root
DB_PASSWORD=root
DB_DIALECT=mysql

# Test database (used only when NODE_ENV=test)
DB_NAME_TEST=working_time_estimation_test

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h

# bcrypt
BCRYPT_SALT_ROUNDS=10
